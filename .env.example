# Pixoo device IP address on your LAN
PIXOO_IP=192.168.10.139

# Comma-separated list of calendar feed URLs (webcal:// or https://)
# Keep private feeds out of git by storing real values in your local .env file.
CALENDAR_FEEDS=https://api.dagsmart.se/ical/holidays

# Optional: start in hello-world test mode instead of calendar mode
# TEST_MODE=false
